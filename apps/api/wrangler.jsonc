{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "aboutyou-private-catalog-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-06",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ALLOWED_ORIGIN": "https://aboutyou-private-catalog-web.pages.dev,https://rinkissaupigiausia.online",
    "WEB_APP_URL": "https://rinkissaupigiausia.online",
    "TELEGRAM_BOT_USERNAME": "AboutYouTrackerBot",
    "GITHUB_OWNER": "mokinys98",
    "GITHUB_REPO": "AboutYou",
    "GITHUB_REF": "main",
    "AI_ENRICHMENT_ENABLED": "true",
    "AI_CRON_ENABLED": "false",
    "AI_INCENTIVE_VERIFIED": "true",
    "AI_DAILY_TOKEN_CAP": "200000"
  },
  "triggers": {
    "crons": [
      "*/15 * * * *",
      "47 * * * *",
      "*/5 * * * *",
      "12 0 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    }
  }
}
